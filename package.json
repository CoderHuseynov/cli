		"eslint-plugin-promise": "^6.6.0",
		"eslint-plugin-security": "^1.7.1",
		"globals": "^15.14.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"typescript-eslint": "^8.19.1"
	},
	"peerDependencies": {
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"appdata-path": "^1.0.0",
		"axios": "^1.7.9",
		"chalk": "^5.4.1",
		"cli-spinners": "^3.2.0",
		"fs-extra": "^11.2.0",
		"i18next": "^24.2.1",
		"i18next-fs-backend": "^2.6.0",
		"ora": "^8.1.1",
		"prompts": "^2.4.2",
